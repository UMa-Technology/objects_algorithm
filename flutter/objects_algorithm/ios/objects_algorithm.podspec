#
# iOS build entry point. Validate with: pod lib lint objects_algorithm.podspec
#
Pod::Spec.new do |s|
  s.name             = 'objects_algorithm'
  s.version          = '0.2.0'
  s.summary          = 'Astronomy algorithms based on AA+ (Flutter FFI plugin)'
  s.description      = <<-DESC
Astronomical positions, rise/transit/set times and coordinate transformations, based on AA+ (http://www.naughter.com/aa.html).
DESC
  s.homepage         = 'https://github.com/UMa-Technology/objects_algorithm'
  s.license          = { :file => '../LICENSE' }
  s.author           = { 'UMa Technology' => 'https://umainf.com' }

  # CocoaPods source_files doesn't accept relative paths outside the pod directory, so
  # Classes/generated holds a layer of #include-only forwarding files while the real C++
  # sources stay in ../src as the single source of truth.
  # The forwarding files are generated by tool/gen_darwin_sources.sh.
  s.source           = { :path => '.' }
  s.source_files     = 'Classes/**/*'
  s.preserve_paths   = '../src/**/*'

  s.dependency 'Flutter'
  s.platform         = :ios, '13.0'

  s.pod_target_xcconfig = {
    'DEFINES_MODULE' => 'YES',
    'EXCLUDED_ARCHS[sdk=iphonesimulator*]' => 'i386',

    # AA+ requires C++17.
    'CLANG_CXX_LANGUAGE_STANDARD' => 'c++17',
    'CLANG_CXX_LIBRARY' => 'libc++',

    # The #include "../../../src/..." in the forwarding files is resolved by file path,
    # but AA+ headers include each other via the include search path, so add it here.
    'HEADER_SEARCH_PATHS' => [
      '"$(PODS_TARGET_SRCROOT)/../src/aaplus"',
      '"$(PODS_TARGET_SRCROOT)/../src/aainterface"',
    ].join(' '),

    # The Dart side looks up KPCAA* symbols at runtime via DynamicLibrary.process() + dlsym;
    # nothing references them at link time. The two settings below plus the keepalive
    # translation unit in Classes/generated together keep the symbols alive until runtime;
    # all three are required:
    #   - GCC_SYMBOLS_PRIVATE_EXTERN=NO: symbols stay global, so dlsym can see them
    #   - DEAD_CODE_STRIPPING=NO: the linker doesn't strip them as unreferenced
    # The host app additionally needs STRIP_STYLE = non-global; a plugin can't and shouldn't
    # change host settings.
    'GCC_SYMBOLS_PRIVATE_EXTERN' => 'NO',
    'DEAD_CODE_STRIPPING' => 'NO',
  }
end
