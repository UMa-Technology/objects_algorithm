#
# macOS build entry point. Validate with: pod lib lint objects_algorithm.podspec
#
# Note: the macOS podspec generated by Flutter 3.44's plugin_ffi template is broken -- it sets
# s.source_files to 'objects_algorithm/Sources/objects_algorithm/**/*' (SPM layout), while the
# template actually places files under macos/Classes/. Copying it verbatim compiles 0 source
# files and exports no symbols. This podspec uses Classes/.
#
Pod::Spec.new do |s|
  s.name             = 'objects_algorithm'
  s.version          = '0.2.0'
  s.summary          = 'Astronomy algorithms based on AA+ (Flutter FFI plugin)'
  s.description      = <<-DESC
Astronomical positions, rise/transit/set times and coordinate transformations, based on AA+ (http://www.naughter.com/aa.html).
DESC
  s.homepage         = 'https://github.com/UMa-Technology/objects_algorithm'
  s.license          = { :file => '../LICENSE' }
  s.author           = { 'UMa Technology' => 'https://umainf.com' }

  # See ios/objects_algorithm.podspec for details.
  s.source           = { :path => '.' }
  s.source_files     = 'Classes/**/*'
  s.preserve_paths   = '../src/**/*'

  s.dependency 'FlutterMacOS'
  s.platform         = :osx, '10.15'

  s.pod_target_xcconfig = {
    'DEFINES_MODULE' => 'YES',

    'CLANG_CXX_LANGUAGE_STANDARD' => 'c++17',
    'CLANG_CXX_LIBRARY' => 'libc++',

    'HEADER_SEARCH_PATHS' => [
      '"$(PODS_TARGET_SRCROOT)/../src/aaplus"',
      '"$(PODS_TARGET_SRCROOT)/../src/aainterface"',
    ].join(' '),

    # This matters even more on macOS: if the host uses bare use_frameworks! (as a typical
    # macOS host Podfile does), this pod is built as a dynamic framework, and in Release
    # GCC_SYMBOLS_PRIVATE_EXTERN defaults to YES, demoting every KPCAA* symbol to local so
    # DynamicLibrary.process() finds none of them.
    'GCC_SYMBOLS_PRIVATE_EXTERN' => 'NO',

    # As a dynamic framework, export only KPCAA* and the plugin class, then enable dead_strip.
    # The setting above makes every symbol global, and each global is a dead_strip root, so
    # the unused VSOP87 A/B/C/E coefficient tables in AA+ (about 8MB) were shipped as is;
    # Android/Windows link CMake static libraries and drop them naturally, so only Apple
    # platforms had this problem. Narrowing the exports shrinks the framework from 12.8MB to
    # 3.5MB, with the KPCAA* exports and computed results bit-for-bit identical.
    # Constraint: every symbol the Dart side looks up must start with KPCAA, or the runtime
    # lookup fails.
    # If the host links this pod statically, these settings don't take part in the host's
    # link and behavior is unchanged (the keepalive still keeps the symbols alive).
    'DEAD_CODE_STRIPPING' => 'YES',
    'OTHER_LDFLAGS' => [
      '$(inherited)',
      '-Wl,-exported_symbol,_KPCAA*',
      '-Wl,-exported_symbol,_OBJC_CLASS_$_ObjectsAlgorithmPlugin',
      '-Wl,-exported_symbol,_OBJC_METACLASS_$_ObjectsAlgorithmPlugin',
    ].join(' '),
  }
end
